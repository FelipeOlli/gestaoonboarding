# Sessão admin (gere com: openssl rand -hex 32)
ADMIN_SESSION_SECRET=altere-este-segredo-em-producao

# Deixe em branco para deduzir automaticamente pela origem do request.
# Em produção atrás de proxy (EasyPanel), defina o domínio final:
# GOOGLE_OAUTH_REDIRECT_URI=https://seu-dominio.com/api/admin/integrations/google/callback
GOOGLE_OAUTH_REDIRECT_URI=

# Banco (libsql/SQLite). Em produção com Docker, aponte para o volume montado:
# TURSO_DATABASE_URL=file:/app/data/local.db
TURSO_DATABASE_URL=file:./data/local.db
TURSO_AUTH_TOKEN=

N8N_MEETING_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

CNPJWS_API_BASE_URL=https://publica.cnpj.ws
ENABLED_SECTOR_TABS=precificacao,fiscal

NODE_ENV=production
PORT=3000
